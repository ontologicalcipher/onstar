    ("Vega","HIP 91262",0.03,18.6156,38.7837,25.0),
    ("Capella","HIP 24608",0.08,5.2782,45.9980,42.9),
    ("Rigel","HIP 24436",0.13,5.2423,-8.2016,860.0),
    ("Procyon","HIP 37279",0.34,7.6550,5.2250,11.46),
    ("Betelgeuse","HIP 27989",0.42,5.9195,7.4071,642.5),
    ("Achernar","HIP 7588",0.46,1.6286,-57.2368,139.0),
