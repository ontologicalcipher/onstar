def db():
    DB.parent.mkdir(exist_ok=True)
    con = sqlite3.connect(DB)
    con.row_factory = sqlite3.Row
    con.execute("""
        CREATE TABLE IF NOT EXISTS stars(
            id INTEGER PRIMARY KEY,
            name TEXT UNIQUE,
            catalog TEXT,
            magnitude REAL,
            ra REAL,
            dec REAL,
            distance REAL
        )
    """)
    con.executemany("""
        INSERT OR IGNORE INTO stars
        (name,catalog,magnitude,ra,dec,distance)
        VALUES(?,?,?,?,?,?)
    """, STARS)
    con.commit()
    return con

@app.get("/")
def index():
    return render_template("index.html")

@app.get("/api/stars")
def stars():
    q = request.args.get("q","").strip()
    con = db()

    if q:
        rows = con.execute(
            "SELECT * FROM stars WHERE name LIKE ? OR catalog LIKE ? ORDER BY magnitude",
            (f"%{q}%", f"%{q}%")
        ).fetchall()
    else:
        rows = con.execute(
            "SELECT * FROM stars ORDER BY magnitude"
        ).fetchall()

    result = [dict(x) for x in rows]
    con.close()
    return jsonify(result)

@app.get("/api/star/<int:star_id>")
def star(star_id):
    con = db()
    row = con.execute(
        "SELECT * FROM stars WHERE id=?",
        (star_id,)
    ).fetchone()
    con.close()

    if not row:
        return jsonify({"error":"Star not found"}),404

    return jsonify(dict(row))

@app.get("/health")
def health():
    return jsonify({"status":"ok","catalog":"local"})

if __name__ == "__main__":
    db().close()
    app.run(host="0.0.0.0",port=5000,debug=False)
